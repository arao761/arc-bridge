{
  "manifest_version": 2,
  "name": "Arc Bridge Companion",
  "version": "0.2.1",
  "description": "Receive reviewed Arc tab migrations in this Firefox profile. All processing stays local.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arcbridge@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "sessions",
    "bookmarks",
    "storage",
    "nativeMessaging",
    "unlimitedStorage"
  ],
  "optional_permissions": ["tabGroups"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Arc Bridge",
    "default_popup": "popup.html"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
