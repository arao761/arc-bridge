{
  "name": "arc-bridge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Move Arc workspaces into Firefox while preserving profile boundaries.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 4321",
    "build": "vite build && node scripts/build.mjs",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "lint:extension": "addons-linter dist-extension",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write core desktop extension src scripts tests docs *.mjs *.cjs *.json README.md"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "parse5": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "addons-linter": "^10.15.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "geckodriver": "^8.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "vite": "^6.4.5"
  },
  "main": "dist-main/main.cjs",
  "author": "arao761"
}
